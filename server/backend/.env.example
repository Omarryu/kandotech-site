# Password to log into /admin — change this before deploying.
ADMIN_PASSWORD=Kandoworld@2026

# Stripe secret key (starts with sk_). Leave unset to disable Stripe checkout.
STRIPE_SECRET_KEY=

# Port the server listens on.
PORT=4242

# Public URL of the deployed site, used to build Stripe redirect links.
# Leave unset for local development (it's inferred from the request).
SITE_URL=

# --- PayPal (optional) ---
# From developer.paypal.com → Apps & Credentials. Leave both unset to hide
# the PayPal option on checkout. Use your Sandbox app's keys while testing.
PAYPAL_CLIENT_ID=AaQaNZNP3HVbSSioh2ybHyUFKnpxyxQyGy2OqZULUdu3KRQitiIV8BWIasDhtU3O0jYizPIrto59ou4O
PAYPAL_CLIENT_SECRET=EEqAwfvsSwWZXB9Tq6K_I2FIjcWRCCetul8Rq57jLZEvpJYtTOPiPAuTP4pLTsMF1CMTdf-FlFi0-OM4
# "sandbox" while testing, "live" once you're ready for real payments.
PAYPAL_ENV=sandbox
# JMD → USD conversion rate used only for PayPal orders (PayPal checkout
# doesn't reliably support JMD). Update this periodically to match the
# real exchange rate — check with your bank or www.boj.org.jm.
PAYPAL_JMD_USD_RATE=0.0064

# --- Lynk (optional) ---
# Your Lynk ID or registered phone number, shown to customers so they can
# pay you directly in the Lynk app. Leave unset to hide the Lynk option.
# See README.md for why this is a manual-confirmation flow for now.
LYNK_ID=
LYNK_MERCHANT_NAME=Kandotech Computer Systems Services
